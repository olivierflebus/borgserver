PUID=1002
PGID=1002
TZ=Europe/Paris

# Host port mapped to the container's SSH port
BORG_SSH_PORT=4804

# mount to /backup
BORG_BACKUP_DIR=/path/to/backup

# mount to /sshkeys
BORG_SSHKEYS_DIR=/path/to/sshkeys

# Additional arguments passed to `borg serve`
BORG_SERVE_ARGS=

# Set to "yes" to restrict delete/prune operations to the admin key
BORG_APPEND_ONLY=yes

# SSH key filename for the admin client
BORG_ADMIN=borg_admin
